# Root Crypto Signal Lab configuration
PORT=3847
# Safe default: serve only this computer. Set 0.0.0.0 only when you intentionally need LAN access.
HOST=127.0.0.1
# Optional extra browser origins, comma-separated. Same-origin requests work automatically.
TRUSTED_ORIGINS=

# Coinbase Advanced Trade credentials
CB_API_KEY=
CB_API_SECRET=

# Optional services
CRYPTORANK_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: protects state-changing API requests. The browser asks once per tab when it is enabled.
APP_API_TOKEN=

# Required for /api/deploy. Leave empty to disable remote deploy.
DEPLOY_KEY=
